
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const name = "Cuennie De La China";
const position = "Web Developer";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{name} | {position}</title>
    </head>

    <body> 
       <body id="page" class="min-h-screen bg-white text-purple-900 duration-300 dark:bg-purple-950 dark:text-white">
       </body>
        <Header />
        <slot />
        <Footer />

        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"
        ></script>

        <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"
        ></script>

        <script>
            import "../scripts/animation.js";
        </script>
    </body>
</html>